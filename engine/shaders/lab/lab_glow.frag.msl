// Shader Lab — glow pulse mode (G): outer free-glow ring on the card.
// Hot-reload: save this file while the lab runs in glow mode (key G).
// Uses lab_card.png only — no normal texture needed.
//
// Look: teal ring starts tight at the card edge, expands outward
// (phase 0→1 loop, fract(time/duration)) and fades alpha 1→0.
// Outer glow only — the card face itself is never tinted.
//
// Tune live:
//   - Host keys: Up/Down = duration, Left/Right = expand, +/- = intensity.
//   - Edit below: ring_w (thickness), corner radius, glow default color.
//   - Host params win for time/duration/expand/intensity on param update.
//
// Rules:
//   - Entry MUST stay named `lab_glow_main` (looked up by name).
//   - VSOutput MUST match sprite_vertex_msl (position/uv/color).
//   - Params MUST be `LabGlowParams` at [[buffer(2)]]: three float4s.
//     (Metal packs vectors at 16-byte boundaries — float4 members ONLY.)
//   - Metal only.

#include <metal_stdlib>
using namespace metal;

struct VSOutput {
    float4 position [[position]];
    float2 uv;
    float4 color;
};

struct LabGlowParams {
    float4 timing; // x = time (s), y = duration (s), z = max expand (uv units), w = ring width
    float4 glow;   // rgba glow color (teal default)
    float4 misc;   // x = card aspect (w/h), y = intensity, z = quad scale k, w = spare
};

float sd_round_box(float2 p, float2 b, float r) {
    float2 q = abs(p) - b + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

fragment float4 lab_glow_main(
    VSOutput               input [[stage_in]],
    texture2d<float>       albedo [[texture(0)]],
    sampler                samp  [[sampler(0)]],
    constant LabGlowParams& p    [[buffer(2)]]
) {
    // The host draws a quad k× larger than the card (margin for the ring
    // to travel in). Remap to card space; the sampler clamps to edge so
    // mask the base by the inside test — the SDF body mask kills it anyway.
    float k = max(p.misc.z, 1.0);
    float2 card_uv = (input.uv - 0.5) * k + 0.5;
    float4 base = albedo.sample(samp, card_uv) * input.color;
    float2 inside2 = step(float2(0.0), card_uv) * step(card_uv, float2(1.0));
    base *= inside2.x * inside2.y;

    // Card-space SDF from card_uv (aspect-correct; edge = 0, outside > 0).
    float aspect = max(p.misc.x, 1e-3);
    float2 pc = (card_uv - 0.5) * float2(aspect, 1.0);
    float2 half_size = float2(aspect * 0.5, 0.5) - 0.03;
    float dist = sd_round_box(pc, half_size, 0.03);

    float aa = max(fwidth(dist), 1e-3);
    float body = 1.0 - smoothstep(-aa, aa, dist);

    // Expanding pulse: ring center travels 0 → max_expand, alpha fades 1 → 0.
    float dur = max(p.timing.y, 1e-3);
    float phase = fract(p.timing.x / dur);
    float center = phase * p.timing.z;
    float ring = 1.0 - smoothstep(0.0, max(p.timing.w, 1e-4), abs(dist - center));
    float outside = smoothstep(-aa, aa, dist); // free (outer) glow only
    float a = ring * outside * (1.0 - phase) * p.glow.a * p.misc.y;

    float3 col = base.rgb * body + p.glow.rgb * a;
    return float4(col, max(base.a * body, a));
}
